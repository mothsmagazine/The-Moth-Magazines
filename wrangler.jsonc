{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-moth-magazine",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "r2_buckets": [
    {
      "binding": "POSTS_BUCKET",
      "bucket_name": "moth-magazine-posts"
    }
  ]
}
